[user-account]
username =
password =

[browser-option]
driver = Chrome
EXE_PATH =
attachExistingChrome = False

[script-option]
enableAutoCaptcha = False
enableVisionCaptcha = True
enableHideWindow = False
showDonateCode = False

[vision-option]
provider = llama
localUrl = http://127.0.0.1:8091
; 实验组合：OpenCV 编号定位 + 本地视觉模型选择，需 uv sync --extra captcha
localPrompt = grounded
imageScale = 3
largeLabels = True

[course-option]
limitMaxTime = 5
limitSpeed = 1.0
soundOff = True

[course-url]
URL1 =
